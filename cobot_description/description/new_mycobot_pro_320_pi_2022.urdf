<?xml version="1.1"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="firefighter">

  <link name="base">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/base.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/base.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 1.5708"/>
    </collision>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link1.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.078" rpy="0 0 1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link1.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.078" rpy="0 0 1.5708"/>
    </collision>
  </link>

  <link name="link2">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link2.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.04" rpy="0 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link2.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.04" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <link name="link3">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link3.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 0.039" rpy="1.5708 1.5708 1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link3.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 0.039" rpy="1.5708 1.5708 1.5708"/>
    </collision>
  </link>

  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link4.dae"/>
      </geometry>
      <origin xyz="0.0 -0.0024 -0.05" rpy="1.5708 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link4.dae"/>
      </geometry>
      <origin xyz="0.0 -0.0024 -0.05" rpy="1.5708 1.5708 0"/>
    </collision>
  </link>

  <link name="link5">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link5.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.05" rpy="0 0 -1.5708"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link5.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.05" rpy="0 0 -1.5708"/>
    </collision>
  </link>

  <link name="link6">
    <visual>
      <geometry>
        <mesh filename="package://cobot_description/assets/link6.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.022" rpy="1.5708 1.5708 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://cobot_description/assets/link6.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 -0.022" rpy="1.5708 1.5708 0"/>
    </collision>
  </link>

  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1739" rpy="0 0 0"/>
  </joint>

  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.35" upper="2.35" velocity="1.0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 -0.08878 0" rpy="0 -1.5708 1.5708"/>
  </joint>

  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.135 0 -0.08878" rpy="0 0 0"/>
  </joint>

  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.120 0 0.08878" rpy="0 0 1.57080"/>
  </joint>

  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 -0.095 0" rpy="1.5708 0 0"/>
  </joint>

  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0.0655 0" rpy="-1.5708 0 0"/>
  </joint>
