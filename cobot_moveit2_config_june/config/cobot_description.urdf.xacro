<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cobot_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import cobot_description urdf file -->
    <xacro:include filename="$(find cobot_description)/description/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="cobot_description.ros2_control.xacro" />


    <xacro:cobot_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
