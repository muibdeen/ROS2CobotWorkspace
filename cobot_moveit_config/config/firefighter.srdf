<?xml version="1.0" encoding="UTF-8"?>
<robot name="firefighter">
    <!-- GROUPS: Clean separation of arm joints and end tool links -->
    <group name="cobot_arm">
        <joint name="VirtualJoint"/>
        <joint name="joint2_to_joint1"/>
        <joint name="joint3_to_joint2"/>
        <joint name="joint4_to_joint3"/>
        <joint name="joint5_to_joint4"/>
        <joint name="joint6_to_joint5"/>
        <joint name="joint6output_to_joint6"/> <!-- The arm group handles all 6 tracking joints -->
    </group>
    

    <!-- GROUP STATES -->
    <group_state name="home" group="cobot_arm">
        <joint name="joint2_to_joint1" value="0"/>
        <joint name="joint3_to_joint2" value="0"/>
        <joint name="joint4_to_joint3" value="0"/>
        <joint name="joint5_to_joint4" value="0"/>
        <joint name="joint6_to_joint5" value="2.5415"/>
        <joint name="joint6output_to_joint6" value="0"/> <!-- Added missing J6 home value -->
    </group_state>

    <!-- END EFFECTOR: Link the pointer directly to the tip of the arm chain -->
    <!-- link6 is the final link outputs by J6, making it the perfect parent link -->
    <end_effector name="end_effector" parent_link="link6" group="end_effector" parent_group="cobot_arm"/>

    <!-- VIRTUAL JOINT -->
    <virtual_joint name="VirtualJoint" type="fixed" parent_frame="world" child_link="base"/>

    <!-- DISABLE COLLISIONS -->
    <disable_collisions link1="base" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="base" link2="link2" reason="Always"/>
    <disable_collisions link1="base" link2="link3" reason="Default"/>
    <disable_collisions link1="base" link2="link4" reason="Always"/>
    <disable_collisions link1="base" link2="link5" reason="Default"/>
    <disable_collisions link1="base" link2="link6" reason="Default"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Always"/>
    <disable_collisions link1="link1" link2="link4" reason="Default"/>
    <disable_collisions link1="link1" link2="link5" reason="Always"/>
    <disable_collisions link1="link1" link2="link6" reason="Always"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link4" reason="Default"/>
    <disable_collisions link1="link2" link2="link5" reason="Always"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link5" reason="Default"/>
    <disable_collisions link1="link3" link2="link6" reason="Always"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link6" reason="Default"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link6" reason="Never"/>
    <disable_collisions link1="link3" link2="link6" reason="Never"/>
    <disable_collisions link1="link4" link2="link6" reason="Never"/>
</robot>
